# Copy this file to backend/.env and fill in your own values.
# backend/.env is git-ignored and must never be committed.

# MongoDB connection string. A local install works fine:
#   MONGODB_URI=mongodb://127.0.0.1:27017/potherbondhu
MONGODB_URI=

# Used to sign the login cookie. Generate a long random value, for example:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# development | production
NODE_ENV=development

# Port the API listens on. The frontend defaults to 4000.
PORT=4000

# SMTP details for the welcome email. Registration still works without
# these - the email failure is logged and the account is created.
SMTP_USER=
SMTP_PASS=
SENDER_EMAIL=

# The site allowed to call the API (comma separated for more than one)
CLIENT_URL=http://localhost:5173
